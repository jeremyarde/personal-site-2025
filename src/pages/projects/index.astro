---
import Layout from "../../layouts/Layout.astro";
import ProjectComponent from "../../components/ProjectComponent.astro";
import {
  clientProjects,
  projectDetails,
  siteCopy,
} from "../../data/siteContent";
---

<Layout title="Projects">
  <div class="mb-12 max-w-3xl pt-12">
    <h1 class="text-3xl font-semibold tracking-[-0.04em] sm:text-4xl">
      {siteCopy.projects.title}
    </h1>
  </div>

  <div class="mb-12 grid gap-10 md:grid-cols-2">
    {
      projectDetails.map((project) => (
        <ProjectComponent imagePath={project.imagePath} project={project} />
      ))
    }
  </div>

  <section class="grid gap-5 border-t border-black/10 pt-8">
    <div>
      <h2 class="text-xl font-semibold">{siteCopy.projects.clientTitle}</h2>
      <p class="mt-2 leading-relaxed text-black/60">
        {siteCopy.projects.clientIntro}
      </p>
    </div>
    <ul class="list-disc space-y-2 pl-5 leading-relaxed text-black/60">
      {clientProjects.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</Layout>
