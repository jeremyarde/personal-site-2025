---
import Layout from "../../layouts/Layout.astro";
import { getPath } from "../../consts";
import { siteCopy } from "../../data/siteContent";
import appIcon from "../../assets/orbits/icon.png";
import overview from "../../assets/orbits/overview.png";
import focus from "../../assets/orbits/focus.png";
import mobileFocus from "../../assets/orbits/mobile-focus.png";

const copy = siteCopy.orbits;
const card =
  "rounded-[22px] border border-[#181513]/12 bg-[#f6f2ec]/70 shadow-[0_6px_18px_rgba(24,21,19,0.08)]";
const primaryButton =
  "inline-flex items-center rounded-full border border-[#14110f] bg-[#14110f] px-6 py-3 text-sm font-semibold text-[#fdf7ef] shadow-[0_10px_25px_rgba(13,11,9,0.25)] transition hover:-translate-y-px hover:bg-[#1a1511]";
---

<Layout title={copy.title} description={copy.description}>
  <section class="grid items-center gap-12 py-14 lg:grid-cols-[.88fr_1.12fr] lg:py-20">
    <div>
      <img src={appIcon.src} alt={copy.alt.icon} class="h-16 w-16 rounded-[18%] shadow-[0_16px_40px_rgba(24,21,19,0.16)]" />
      <h1 class="my-7 font-serif text-5xl leading-none tracking-tight sm:text-6xl xl:text-7xl">{copy.headline}</h1>
      <p class="max-w-xl text-lg leading-relaxed text-[#6a625c]">{copy.heroBody}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a class={primaryButton} href={copy.desktop.href} target="_blank" rel="noopener noreferrer">{copy.desktop.label} <span aria-hidden="true">↗</span></a>
        <a href={copy.appStore.badge.href} target="_blank" rel="noopener noreferrer" aria-label={copy.appStore.badge.alt}>
          <img src={copy.appStore.badge.src} alt={copy.appStore.badge.alt} class="h-[41px] w-[123px] object-contain sm:h-[49px] sm:w-[147px]" />
        </a>
      </div>
    </div>
    <div class={`${card} overflow-hidden bg-[#080b16] p-2`}>
      <img src={overview.src} alt={copy.alt.overview} class="block w-full rounded-2xl" />
    </div>
  </section>

  <section class="pb-20 pt-4">
    <h2 class="m-0 font-serif text-4xl leading-tight">{copy.featuresTitle}</h2>
    <div class="mt-9 grid gap-5 md:grid-cols-3">
      {copy.features.map((feature) => (
        <article class={`${card} p-7`}>
          <h3 class="m-0 font-serif text-2xl">{feature.title}</h3>
          <p class="mt-4 leading-relaxed text-[#6a625c]">{feature.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class={`${card} grid items-center gap-10 p-8 md:grid-cols-[.8fr_1.2fr] sm:p-10`}>
    <div>
      <h2 class="m-0 font-serif text-4xl leading-tight">{copy.spotlight.title}</h2>
      <p class="mt-5 leading-relaxed text-[#6a625c]">{copy.spotlight.body}</p>
      <div class="mt-5 flex flex-wrap gap-5">
        <a href={getPath("orbits/privacy-policy")}>{copy.links.privacy}</a>
        <a href={getPath("orbits/support")}>{copy.links.support}</a>
      </div>
    </div>
    <img src={focus.src} alt={copy.alt.focus} class="block w-full rounded-xl" />
  </section>

  <section class="mx-auto my-20 grid max-w-3xl items-center gap-10 md:grid-cols-[.9fr_.7fr]">
    <div class="justify-self-center rounded-[2.4rem] bg-[#090c17] p-2 shadow-[0_30px_80px_rgba(24,21,19,0.22)] md:justify-self-end">
      <img src={mobileFocus.src} alt={copy.alt.mobile} class="block w-72 rounded-[2rem]" />
    </div>
    <div>
      <p class="mb-4 text-xs uppercase tracking-[0.24em] text-[#9a8f86]">{copy.mobile.eyebrow}</p>
      <h2 class="m-0 font-serif text-4xl leading-tight">{copy.mobile.title}</h2>
      <p class="mb-5 mt-4 text-[#6a625c]">{copy.mobile.body}</p>
      <a href={copy.appStore.badge.href} target="_blank" rel="noopener noreferrer" aria-label={copy.appStore.badge.alt}>
        <img src={copy.appStore.badge.src} alt={copy.appStore.badge.alt} class="h-[41px] w-[123px] object-contain" />
      </a>
    </div>
  </section>

  <p class="mx-auto my-16 max-w-2xl text-center text-sm leading-relaxed text-[#6a625c]">
    {copy.maker.before} <a href={copy.maker.href}>{copy.maker.name}</a>. {copy.maker.after} <a href={`mailto:${copy.supportEmail}`}>{copy.maker.emailLabel}</a>.
  </p>

  <details class="my-14 border-y border-[#181513]/10 py-5 text-sm text-[#6a625c]">
    <summary class="cursor-pointer font-medium text-[#181513]">{copy.detailsTitle}</summary>
    <dl class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-[9rem_1fr]">
      {copy.details.map((detail) => <><dt class="font-medium text-[#181513]">{detail.label}</dt><dd>{detail.href ? <a href={detail.href}>{detail.value}</a> : detail.value}</dd></>)}
    </dl>
  </details>

  <section class={`${card} mb-12 p-8 sm:p-10`}>
    <h2 class="m-0 font-serif text-4xl leading-tight">{copy.faqTitle}</h2>
    <div class="mt-8 space-y-8">
      {copy.faqs.map((faq) => <div><h3 class="m-0 font-serif text-2xl">{faq.question}</h3><p class="mt-3 leading-relaxed text-[#6a625c]">{faq.answer}</p></div>)}
    </div>
  </section>
</Layout>
