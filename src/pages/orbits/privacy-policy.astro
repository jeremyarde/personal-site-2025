---
import Layout from "../../layouts/Layout.astro";
import { siteCopy } from "../../data/siteContent";
const copy = siteCopy.privacy;
---

<Layout title={copy.title} description={copy.description}>
  <article class="max-w-3xl py-12 text-base leading-relaxed [&_h2]:mt-10 [&_h2]:font-serif [&_h2]:text-3xl [&_h2]:leading-tight [&_p]:mb-6 [&_p]:max-w-2xl">
    <p class="mb-3 text-xs uppercase tracking-[0.24em] text-[#9a8f86]">{copy.productLabel}</p>
    <h1 class="m-0 font-serif text-5xl leading-none tracking-tight">{copy.heading}</h1>
    <p class="mb-10 mt-6 text-[#6a625c]"><strong>Last updated:</strong> {copy.updated}</p>
    {copy.sections.map((section) => <>{section.title ? <h2>{section.title}</h2> : null}<p>{section.body}</p></>)}
    <h2>{copy.contact.title}</h2>
    <p>{copy.contact.before} <a href={`mailto:${copy.contact.email}`}>{copy.contact.email}</a>.</p>
  </article>
</Layout>
