---
import Layout from "../layouts/Layout.astro";
import { getPath } from "../consts";
import { projectDetails, siteCopy } from "../data/siteContent";
const featuredProjects = projectDetails.filter((project) => project.featured);
---

<Layout>
  <section class="max-w-3xl py-16 lg:py-20">
    <div>
      <h1 class="text-3xl font-semibold tracking-[-0.04em] sm:text-4xl">
        {siteCopy.home.introduction}
      </h1>
      <!-- <p class="mt-6 text-lg leading-relaxed text-black/70">
        {siteCopy.home.introduction}
      </p> -->
      <p class="mt-4 leading-relaxed text-black/60">{siteCopy.home.summary}</p>
      <div class="mt-12">
        <h2 class="text-lg font-semibold">{siteCopy.home.selectedWorkTitle}</h2>
        <ul class="mt-4 divide-y divide-black/10 border-t border-black/10">
          {
            featuredProjects.slice(0, 3).map((project) => (
              <li class="py-4">
                <>
                  <a
                    href={project.site_url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.project_title}
                  </a>
                  <span class="block pt-1 text-sm leading-relaxed text-black/55">
                    {project.description}
                  </span>
                </>
              </li>
            ))
          }
          <li class="py-4 text-sm">
            <a href={getPath("projects")}>{siteCopy.home.allProjectsLabel}</a>
          </li>
        </ul>
      </div>

      <!-- <div class="mt-10 border-t border-black/10 pt-5">
        <p class="text-sm text-black/50">Areas of focus</p> -->
      <!-- <p class="mt-2 leading-relaxed">{siteCopy.home.focusValue}</p> -->
    </div>
  </section>
</Layout>
