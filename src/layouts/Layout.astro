---
import BaseHead from "../components/BaseHead.astro";
import "../styles/global.css";
import { SITE_TITLE, SITE_DESCRIPTION, getPath } from "../consts";
import { siteCopy } from "../data/siteContent";

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="min-h-screen bg-white font-['Inter'] text-[#171717] antialiased selection:bg-[#171717] selection:text-white">
    <div class="min-h-screen px-5 py-6 sm:px-8 sm:py-8">
      <header class="mx-auto flex w-full max-w-4xl items-center justify-between gap-6 border-b border-black/10 pb-5">
        <a href={getPath("")} class="text-sm font-semibold tracking-tight">{SITE_TITLE}</a>
        <nav aria-label="Primary" class="flex flex-wrap justify-end gap-x-5 gap-y-2 text-sm text-black/60">
          {
            siteCopy.layout.navigation.map((item) => {
              const isExternal = item.path.startsWith("mailto:");
              const fullPath = isExternal ? item.path : getPath(item.path);
              return (
                <a
                  href={fullPath}
                  class:list={[
                    "transition-colors hover:text-black",
                    {
                      "text-black":
                        currentPath === fullPath ||
                        (item.path !== "" && currentPath.startsWith(fullPath)),
                      "text-black/60":
                        currentPath !== fullPath &&
                        (item.path === "" || !currentPath.startsWith(fullPath)),
                    },
                  ]}
                >
                  {item.name}
                </a>
              );
            })
          }
        </nav>
      </header>
      <main class="mx-auto w-full max-w-4xl [&_a:not([class])]:font-medium [&_a:not([class])]:underline [&_a:not([class])]:underline-offset-4">
        <slot />
      </main>

      <footer class="mx-auto mt-20 flex w-full max-w-4xl flex-wrap justify-between gap-6 border-t border-black/10 py-6 text-sm">
        <span class="text-black/50">© {new Date().getFullYear()} {SITE_TITLE}</span>
        <div class="flex flex-wrap gap-5">
          {Object.values(siteCopy.layout.footer).map((link) => (
            <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} class="transition-opacity hover:opacity-50">{link.label}</a>
          ))}
        </div>
      </footer>
    </div>
  </body>
</html>
