---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getPath } from "../consts";
import { siteCopy, type Project } from "../data/siteContent";

interface Props { imagePath?: string; project: Project; }
const { imagePath, project } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/**/*.{jpeg,jpg,png,gif}");
const isAssetPath = imagePath?.startsWith("/src/assets/");
const isPublicPath = Boolean(imagePath && !isAssetPath);
if (isAssetPath && !images[imagePath]) throw new Error(`"${imagePath}" does not exist in glob: "src/assets/**/*.{jpeg,jpg,png,gif}"`);
const copy = siteCopy.projectCard;
---

<article class="border-t border-black/10 pt-5">
  {project.imagePath && <div class="aspect-[16/10] overflow-hidden bg-black/5">
    {isPublicPath ? (
      <img class="h-full w-full object-cover object-top" src={getPath(project.imagePath)} alt={project.project_title} width={600} height={400} />
    ) : (
      <Image class="h-full w-full object-cover object-top" src={images[project.imagePath!]()} alt={project.project_title} width={600} height={400} />
    )}
  </div>}
  <div class="pt-5">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
      <h2 class="text-lg font-semibold">{project.site_url || project.github_url ? <a href={project.site_url || project.github_url} target="_blank" rel="noopener noreferrer">{project.project_title}</a> : project.project_title}</h2>
      {project.tag && <span class="text-sm text-black/45">{project.tag}</span>}
    </div>
    <p class="mt-2 text-sm leading-relaxed text-black/60">{project.description || copy.fallbackDescription}</p>
    <p class="mt-3 text-sm text-black/45">{project.keywords.join(" · ")}</p>
    <div class="mt-4 flex flex-wrap gap-4 text-sm">
      {project.site_url && <a href={project.site_url} target="_blank" rel="noopener noreferrer">{copy.viewLive} →</a>}
      {project.github_url && <a href={project.github_url} target="_blank" rel="noopener noreferrer">{copy.viewSource} →</a>}
    </div>
  </div>
</article>
